# ==============================================================================
# Environment Configuration Template
# YottaFlex Demand Forecasting & Inventory Replenishment System
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=yottaflex
POSTGRES_PASSWORD=yottaflex_secure_password
POSTGRES_DB=yottaflex_demand
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URL
DATABASE_URL=postgresql+psycopg://yottaflex:yottaflex_secure_password@localhost:5432/yottaflex_demand

# Optional Fallback Database URL (for offline testing if Docker is inactive)
SQLITE_DATABASE_URL=sqlite:///./yottaflex_dev.db

# Synthetic Data Generation Parameters
RANDOM_SEED=20261022
DATASET_PROFILE=dev
# Options: dev (100 SKUs, 10 stores, 90 days), full (2000 SKUs, 100 stores, 365 days)

# CORS Frontend URL
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

